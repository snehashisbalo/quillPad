<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.openjfx.controller.DashboardController"
            styleClass="dashboard-container">

    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="5">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            <children>
                <Button fx:id="newProjectButton"
                        text="+ New Note"
                        styleClass="create-button, primary-button"
                        onAction="#handleNewProject"
                        maxWidth="Infinity"
                        prefHeight="40">
                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>
                </Button>

                <Button fx:id="openFileButton"
                        text="📂 Open File"
                        styleClass="sidebar-button"
                        onAction="#handleOpenFile"
                        maxWidth="Infinity"
                        prefHeight="40">
                    <VBox.margin>
                        <Insets top="8"/>
                    </VBox.margin>
                </Button>

                <Separator styleClass="sidebar-separator">
                    <VBox.margin>
                        <Insets top="10" bottom="10"/>
                    </VBox.margin>
                </Separator>

                <HBox fx:id="homeNavItem" styleClass="sidebar-btn-text" onMouseClicked="#handleMyNotes">
                    <children>
                        <Label text="🏠" style="-fx-font-size: 16px;"/>
                        <Label text="Home" styleClass="sidebar-btn-text">
                            <HBox.margin>
                                <Insets left="10"/>
                            </HBox.margin>
                        </Label>
                    </children>
                    <padding>
                        <Insets top="8" right="10" bottom="8" left="10"/>
                    </padding>
                </HBox>

                <HBox fx:id="starredNavItem" styleClass="sidebar-btn-text" onMouseClicked="#handleStarred">
                    <children>
                        <Label text="⭐" style="-fx-font-size: 16px;"/>
                        <Label text="Starred" styleClass="sidebar-btn-text">
                            <HBox.margin>
                                <Insets left="10"/>
                            </HBox.margin>
                        </Label>
                    </children>
                    <padding>
                        <Insets top="8" right="10" bottom="8" left="10"/>
                    </padding>
                </HBox>

                <HBox fx:id="trashNavItem" styleClass="sidebar-btn-text" onMouseClicked="#handleTrash">
                    <children>
                        <Label text="🗑️" style="-fx-font-size: 16px;"/>
                        <Label text="Trash" styleClass="sidebar-btn-text">
                            <HBox.margin>
                                <Insets left="10"/>
                            </HBox.margin>
                        </Label>
                    </children>
                    <padding>
                        <Insets top="8" right="10" bottom="8" left="10"/>
                    </padding>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="settingsButton"
                        text="⚙️ Settings"
                        styleClass="sidebar-button"
                        onAction="#handleSettings"
                        maxWidth="Infinity"
                        prefHeight="40">
                    <VBox.margin>
                        <Insets bottom="5"/>
                    </VBox.margin>
                </Button>

                <Button fx:id="resetStorageButton"
                        text="🧹 Reset Storage"
                        styleClass="sidebar-button"
                        onAction="#handleResetStorage"
                        maxWidth="Infinity"
                        prefHeight="40">
                    <VBox.margin>
                        <Insets bottom="5"/>
                    </VBox.margin>
                </Button>

                <Button fx:id="themeToggleButton"
                        text="🌸 Theme"
                        styleClass="sidebar-button"
                        onAction="#handleThemeToggle"
                        maxWidth="Infinity"
                        prefHeight="40">
                    <VBox.margin>
                        <Insets bottom="5"/>
                    </VBox.margin>
                </Button>

                <Button fx:id="logoutButton"
                        text="🚪 Logout"
                        styleClass="sidebar-button, logout-button"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        prefHeight="40"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <Label text="📝" style="-fx-font-size: 28px;"/>
                        <Label text="QuillPad" styleClass="page-title">
                            <font>
                                <Font name="System Bold" size="22"/>
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS"/>

                        <ToggleButton fx:id="manageTagsButton"
                                      text="🏷 Tags"
                                      onAction="#handleManageTags"
                                      styleClass="icon-button"/>

                        <TextField fx:id="searchField"
                                   promptText="🔍 Search notes or #tags..."
                                   prefWidth="250"
                                   styleClass="search-field"/>

                        <Label fx:id="welcomeLabel" text="Welcome!" styleClass="stats-label">
                            <font>
                                <Font size="14"/>
                            </font>
                        </Label>
                    </children>
                </HBox>

                <Separator/>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Recent Notes" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="20"/>
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statsLabel" text="0 notes" styleClass="stats-label">
                            <font>
                                <Font size="14"/>
                            </font>
                        </Label>
                        <Button fx:id="refreshButton"
                                text="🔄"
                                styleClass="icon-button"
                                onAction="#handleRefresh">
                            <HBox.margin>
                                <Insets left="10"/>
                            </HBox.margin>
                        </Button>
                        <Button fx:id="uploadButton"
                                text="⬆ Upload"
                                styleClass="icon-button"
                                onAction="#handleUploadSelected">
                            <HBox.margin>
                                <Insets left="8"/>
                            </HBox.margin>
                        </Button>
                        <Button fx:id="remoteButton"
                                text="⬇ Download"
                                styleClass="icon-button"
                                onAction="#handleRemoteBrowse">
                            <HBox.margin>
                                <Insets left="8"/>
                            </HBox.margin>
                        </Button>
                        <Button fx:id="myUploadsButton"
                                text="☁ My Uploads"
                                styleClass="icon-button"
                                onAction="#handleMyUploads">
                            <HBox.margin>
                                <Insets left="8"/>
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <ListView fx:id="recentProjectsList"
                          styleClass="notes-list"
                          onMouseClicked="#handleProjectSelected"
                          VBox.vgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="deleteButton"
                            text="🗑️ Delete Selected"
                            styleClass="delete-button"
                            onAction="#handleDelete"/>
                </HBox>

                <Label text="💡 Tip: Double-click a note to open it" styleClass="hint-label">
                    <font>
                        <Font size="12"/>
                    </font>
                </Label>
            </children>
        </VBox>
    </center>

</BorderPane>
