<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane styleClass="credits-root" stylesheets="@credits.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.controller.CreditsController">

    <ImageView fitHeight="1080.0" fitWidth="1920.0" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <image>
            <Image url="@credits-bg.png" />
        </image>
    </ImageView>

    <AnchorPane styleClass="overlay" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" styleClass="credits-topbar">
                    <padding>
                        <Insets bottom="0.0" left="44.0" right="44.0" top="40.0" />
                    </padding>
                    <Button fx:id="backButton" onAction="#handleBack" prefHeight="10.0" prefWidth="85.0" styleClass="back-button" text="Back">
                  <HBox.margin>
                     <Insets left="50.0" top="50.0" />
                  </HBox.margin></Button>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
            </top>

            <center>
                <VBox alignment="CENTER" fillWidth="true" spacing="34.0" styleClass="credits-content">
                    <padding>
                        <Insets bottom="36.0" left="40.0" right="40.0" top="20.0" />
                    </padding>

                    <HBox alignment="CENTER" spacing="15.0">
                        <Line endX="120.0" stroke="white" strokeWidth="2.0" />
                        <Label styleClass="diamond" text="◆" />
                        <Label styleClass="title-label" text="QuillPad" />
                        <Label styleClass="diamond" text="◆" />
                        <Line endX="120.0" stroke="white" strokeWidth="2.0" />
                    </HBox>

                    <VBox alignment="CENTER" spacing="12.0">
                        <Label styleClass="role-header" text="Developed By" />
                        <HBox alignment="TOP_CENTER" spacing="120.0" styleClass="developer-row">
                            <VBox alignment="CENTER" spacing="10.0" styleClass="developer-card">
                                <Label styleClass="name-item-large" text="Snehashis Balo" />
                                <Label styleClass="roll-item" text="Roll: 2405069" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="10.0" styleClass="developer-card">
                                <Label styleClass="name-item-large" text="Abdullah Ikra" />
                                <Label styleClass="roll-item" text="Roll: 2405070" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10.0" styleClass="supervisor-block">
                        <Label styleClass="role-header" text="Supervisor" />
                        <Label styleClass="name-item-large" text="A.K.M. Mehedi Hasan" />
                        <Label styleClass="roll-item" text="Lecturer" />
                    </VBox>
                </VBox>
            </center>
        </BorderPane>
    </AnchorPane>
</AnchorPane>
