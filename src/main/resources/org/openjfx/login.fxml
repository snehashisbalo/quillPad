<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" spacing="0.0" styleClass="login-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.controller.LoginController">

    <VBox alignment="CENTER" minWidth="320" styleClass="login-left-panel" HBox.hgrow="ALWAYS">
        <children>
            <VBox alignment="CENTER" maxWidth="420.0" spacing="6.0">
                <children>
                    <Label styleClass="app-title app-wordmark" text="QuillPad">
                        <font>
                            <Font size="50.0" />
                        </font>
                    </Label>
                    <Label styleClass="app-subtitle" text="Capture every keystroke">
                        <font>
                            <Font size="24.0" />
                        </font>
                        <VBox.margin>
                            <Insets top="10" />
                        </VBox.margin>
                    </Label>
                </children>
            </VBox>
        </children>
        <padding>
            <Insets bottom="20" left="40" right="40" top="20" />
        </padding>
    </VBox>

    <VBox alignment="CENTER" maxWidth="680" minWidth="440" styleClass="login-right-panel" translateX="-26.0" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="20" left="32" right="32" top="20" />
        </padding>
        <children>
            <VBox alignment="CENTER" maxWidth="400" spacing="15" styleClass="form-container">
                <padding>
                    <Insets bottom="30" left="40" right="40" top="30" />
                </padding>

                <HBox alignment="CENTER">
                    <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="themeToggleButton" onAction="#handleThemeToggle" styleClass="theme-toggle-button" text="🌸" />
                    </children>
                </HBox>

                <Label styleClass="app-title" text="Welcome Back!">
                    <font>
                        <Font name="System Bold" size="28" />
                    </font>
                </Label>

                <Label styleClass="hint-label" text="Enter your username and password">
                    <font>
                        <Font size="12" />
                    </font>
                </Label>

                <HBox alignment="CENTER_LEFT" styleClass="input-field-container">
                    <TextField fx:id="usernameField" promptText="Enter your username" styleClass="form-input" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER_LEFT" styleClass="input-field-container">
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="passwordField" managed="true" promptText="Enter your password" styleClass="form-input" visible="true" />
                        <TextField fx:id="passwordTextField" managed="false" promptText="Enter your password" styleClass="form-input" visible="false" />
                    </StackPane>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <CheckBox fx:id="showPasswordCheckBox" onAction="#handleShowPasswordToggle" styleClass="show-password-checkbox" text="Show Password" />
                    </children>
                </HBox>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />

                <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" prefHeight="45" styleClass="login-button" text="LOG IN">
                    <font>
                        <Font name="System Bold" size="14" />
                    </font>
                </Button>

                <Button fx:id="registerButton" maxWidth="Infinity" onAction="#handleRegister" prefHeight="45" styleClass="register-button" text="REGISTER">
                    <font>
                        <Font size="14" />
                    </font>
                </Button>

                <Label styleClass="hint-label" text="Tip: Username must be 3+ characters">
                    <font>
                        <Font size="11" />
                    </font>
                </Label>
            </VBox>
        </children>
    </VBox>

</HBox>
