<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.openjfx.controller.LoginController"
            styleClass="login-container">

    <!-- Left Side - Illustration Area -->
    <left>
        <VBox styleClass="login-left-panel"
              alignment="CENTER"
              prefWidth="400"
              minWidth="300">
            <children>
                <Label text="QuillPad" styleClass="app-title">
                    <font>
                        <Font name="System Bold" size="42"/>
                    </font>
                </Label>
                <Label text="Note Taking" styleClass="app-subtitle">
                    <font>
                        <Font size="24"/>
                    </font>
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
                <Label text="Made Simple" styleClass="app-subtitle">
                    <font>
                        <Font size="24"/>
                    </font>
                </Label>
            </children>
        </VBox>
    </left>

    <!-- Right Side - Login Form -->
    <center>
        <VBox alignment="CENTER"
              styleClass="login-right-panel"
              minWidth="400">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <!-- Form Container -->
                <VBox styleClass="form-container" 
                      alignment="CENTER"
                      maxWidth="400"
                      spacing="15">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>
                    
                    <!-- Header with Theme Toggle -->
                    <HBox alignment="CENTER">
                        <children>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="themeToggleButton" text="🌸"
                                    styleClass="theme-toggle-button"
                                    onAction="#handleThemeToggle"/>
                        </children>
                    </HBox>

                    <Label text="Welcome Back!" styleClass="app-title">
                        <font>
                            <Font name="System Bold" size="28"/>
                        </font>
                    </Label>

                    <Label text="Enter your username and password"
                           styleClass="hint-label">
                        <font>
                            <Font size="12"/>
                        </font>
                    </Label>

                    <!-- Username Field -->
                    <HBox styleClass="input-field-container" alignment="CENTER_LEFT">
                        <TextField fx:id="usernameField"
                                   promptText="Enter your username"
                                   styleClass="form-input"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- Password Field -->
                    <HBox styleClass="input-field-container" alignment="CENTER_LEFT">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="passwordField"
                                           promptText="Enter your password"
                                           styleClass="form-input"
                                           managed="true"
                                           visible="true"/>
                            <TextField fx:id="passwordTextField"
                                       promptText="Enter your password"
                                       styleClass="form-input"
                                       managed="false"
                                       visible="false"/>
                        </StackPane>
                    </HBox>
                    
                    <!-- Show/Hide Password Toggle -->
                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <CheckBox fx:id="showPasswordCheckBox" 
                                      text="Show Password"
                                      styleClass="show-password-checkbox"
                                      onAction="#handleShowPasswordToggle"/>
                        </children>
                    </HBox>

                    <!-- Error Label -->
                    <Label fx:id="errorLabel"
                           wrapText="true"
                           styleClass="error-label"/>

                    <!-- Login Button -->
                    <Button fx:id="loginButton"
                            maxWidth="Infinity"
                            prefHeight="45"
                            text="LOG IN"
                            styleClass="login-button"
                            onAction="#handleLogin">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Button>

                    <!-- Register Button -->
                    <Button fx:id="registerButton"
                            maxWidth="Infinity"
                            prefHeight="45"
                            text="REGISTER"
                            styleClass="register-button"
                            onAction="#handleRegister">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Button>

                    <!-- Hint -->
                    <Label text="Tip: Username must be 3+ characters"
                           styleClass="hint-label">
                        <font>
                            <Font size="11"/>
                        </font>
                    </Label>
                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>
