<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="editor-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.controller.EditorController">

    <top>
        <VBox>
            <MenuBar styleClass="menu-bar">
                <menus>
                    <Menu text="File">
                        <items>
                            <MenuItem fx:id="newMenuItem" text="New" />
                            <MenuItem fx:id="openMenuItem" text="Open..." />
                            <MenuItem fx:id="saveMenuItem" text="Save" />
                            <MenuItem fx:id="saveAsMenuItem" text="Save As..." />
                            <MenuItem fx:id="renameMenuItem" text="Rename..." />
                            <MenuItem fx:id="closeMenuItem" text="Close" />
                        </items>
                    </Menu>

                    <Menu text="Edit">
                        <items>
                            <MenuItem fx:id="undoMenuItem" text="Undo" />
                            <MenuItem fx:id="redoMenuItem" text="Redo" />
                            <MenuItem fx:id="cutMenuItem" text="Cut" />
                            <MenuItem fx:id="copyMenuItem" text="Copy" />
                            <MenuItem fx:id="pasteMenuItem" text="Paste" />
                            <MenuItem fx:id="selectAllMenuItem" text="Select All" />
                            <MenuItem fx:id="findMenuItem" text="Find..." />
                            <MenuItem fx:id="replaceMenuItem" text="Replace..." />
                        </items>
                    </Menu>

                    <Menu text="View">
                        <items>
                            <CheckMenuItem fx:id="wordWrapMenuItem" selected="true" text="Word Wrap" />
                            <MenuItem fx:id="increaseFontMenuItem" text="Increase Font Size" />
                            <MenuItem fx:id="decreaseFontMenuItem" text="Decrease Font Size" />
                            <MenuItem fx:id="resetFontMenuItem" text="Reset Font Size" />
                        </items>
                    </Menu>

                    <Menu text="Tags">
                        <items>
                            <MenuItem fx:id="addTagMenuItem" text="Add Tag..." />
                            <MenuItem fx:id="manageTagMenuItem" text="Manage Tags..." />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar fx:id="formattingToolBar" styleClass="formatting-toolbar">
                <Label styleClass="toolbar-label" text="Tags:" />
                <HBox fx:id="tagChipPane" alignment="CENTER_LEFT" spacing="6" />

                <Label styleClass="toolbar-label" text="Font:" />
                <ComboBox fx:id="fontFamilyCombo" prefHeight="26.0" prefWidth="173.0" />

                <Label styleClass="toolbar-label" text="Size:">
                    <padding>
                        <Insets left="10" />
                    </padding>
                </Label>
                <ComboBox fx:id="fontSizeCombo" prefHeight="26.0" prefWidth="95.0" />

                <ToggleButton fx:id="boldButton" styleClass="bold-button" text="B">
                    <tooltip>
                        <Tooltip text="Bold (Ctrl+B)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="italicButton" styleClass="italic-button" text="I">
                    <tooltip>
                        <Tooltip text="Italic (Ctrl+I)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="underlineButton" styleClass="underline-button" text="U">
                    <tooltip>
                        <Tooltip text="Underline (Ctrl+U)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="strikethroughButton" styleClass="strikethrough-button" text="S">
                    <tooltip>
                        <Tooltip text="Strikethrough" />
                    </tooltip>
                </ToggleButton>

                <Label styleClass="toolbar-label" text="Color:" />
                <ColorPicker fx:id="textColorPicker" prefHeight="26.0" prefWidth="140.0" styleClass="text-color-picker">
                    <tooltip>
                        <Tooltip text="Text Color" />
                    </tooltip>
                </ColorPicker>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="themeToggleButton" styleClass="theme-toggle-button editor-theme-toggle-button" text="☀️">
                    <tooltip>
                        <Tooltip text="Toggle Theme" />
                    </tooltip>
                </Button>

            </ToolBar>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" styleClass="editor-tabs" tabClosingPolicy="ALL_TABS">
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="status-bar">
            <padding>
                <Insets bottom="8" left="15" right="15" top="8" />
            </padding>
            <children>
                <Label fx:id="fileStatusLabel" styleClass="status-item" text="Ready" />

                <Label fx:id="lineLabel" styleClass="status-item" text="Line: 1" />

                <Label fx:id="columnLabel" styleClass="status-item" text="Col: 1" />

                <Label fx:id="wordCountLabel" styleClass="status-item" text="Words: 0" />

                <Label fx:id="charCountLabel" styleClass="status-item" text="Chars: 0" />

                <Region HBox.hgrow="ALWAYS" />

                <Label styleClass="version-label app-wordmark" text="QuillPad v1.0" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
