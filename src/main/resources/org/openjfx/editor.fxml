<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.openjfx.controller.EditorController"
            styleClass="editor-container">

    <top>
        <VBox>
            <MenuBar styleClass="menu-bar">
                <menus>
                    <Menu text="File">
                        <items>
                            <MenuItem fx:id="newMenuItem" text="New"/>
                            <MenuItem fx:id="openMenuItem" text="Open..."/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="saveMenuItem" text="Save"/>
                            <MenuItem fx:id="saveAsMenuItem" text="Save As..."/>
                            <MenuItem fx:id="renameMenuItem" text="Rename..."/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="closeMenuItem" text="Close"/>
                        </items>
                    </Menu>

                    <Menu text="Edit">
                        <items>
                            <MenuItem fx:id="undoMenuItem" text="Undo"/>
                            <MenuItem fx:id="redoMenuItem" text="Redo"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="cutMenuItem" text="Cut"/>
                            <MenuItem fx:id="copyMenuItem" text="Copy"/>
                            <MenuItem fx:id="pasteMenuItem" text="Paste"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="selectAllMenuItem" text="Select All"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="findMenuItem" text="Find..."/>
                            <MenuItem fx:id="replaceMenuItem" text="Replace..."/>
                        </items>
                    </Menu>

                    <Menu text="View">
                        <items>
                            <CheckMenuItem fx:id="wordWrapMenuItem" text="Word Wrap" selected="true"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="increaseFontMenuItem" text="Increase Font Size"/>
                            <MenuItem fx:id="decreaseFontMenuItem" text="Decrease Font Size"/>
                            <MenuItem fx:id="resetFontMenuItem" text="Reset Font Size"/>
                        </items>
                    </Menu>

                    <Menu text="Tags">
                        <items>
                            <MenuItem fx:id="addTagMenuItem" text="Add Tag..."/>
                            <MenuItem fx:id="manageTagMenuItem" text="Manage Tags..."/>
                        </items>
                    </Menu>

                    <Menu text="Help">
                        <items>
                            <MenuItem fx:id="aboutMenuItem" text="About QuillPad"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar fx:id="formattingToolBar" styleClass="formatting-toolbar">
                <Label text="Tags:" styleClass="toolbar-label"/>
                <HBox fx:id="tagChipPane" spacing="6" alignment="CENTER_LEFT"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Font:" styleClass="toolbar-label"/>
                <ComboBox fx:id="fontFamilyCombo" prefWidth="120"/>

                <Label text="Size:" styleClass="toolbar-label">
                    <padding>
                        <Insets left="10"/>
                    </padding>
                </Label>
                <ComboBox fx:id="fontSizeCombo" prefWidth="70"/>

                <Separator orientation="VERTICAL"/>

                <ToggleButton fx:id="boldButton" text="B" styleClass="bold-button">
                    <tooltip>
                        <Tooltip text="Bold (Ctrl+B)"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="italicButton" text="I" styleClass="italic-button">
                    <tooltip>
                        <Tooltip text="Italic (Ctrl+I)"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="underlineButton" text="U" styleClass="underline-button">
                    <tooltip>
                        <Tooltip text="Underline (Ctrl+U)"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="strikethroughButton" text="S" styleClass="strikethrough-button">
                    <tooltip>
                        <Tooltip text="Strikethrough"/>
                    </tooltip>
                </ToggleButton>

                <Separator orientation="VERTICAL"/>

                <Label text="Text:" styleClass="toolbar-label"/>
                <ColorPicker fx:id="textColorPicker" styleClass="text-color-picker">
                    <tooltip>
                        <Tooltip text="Text Color"/>
                    </tooltip>
                </ColorPicker>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="themeToggleButton" text="☀️" styleClass="theme-toggle-button editor-theme-toggle-button">
                    <tooltip>
                        <Tooltip text="Toggle Theme"/>
                    </tooltip>
                </Button>

            </ToolBar>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPane"
                 tabClosingPolicy="ALL_TABS"
                 styleClass="editor-tabs">
        </TabPane>
    </center>

    <bottom>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="status-bar">
            <padding>
                <Insets top="8" right="15" bottom="8" left="15"/>
            </padding>
            <children>
                <Label fx:id="fileStatusLabel"
                       text="Ready"
                       styleClass="status-item"/>

                <Separator orientation="VERTICAL"/>

                <Label fx:id="lineLabel"
                       text="Line: 1"
                       styleClass="status-item"/>

                <Label fx:id="columnLabel"
                       text="Col: 1"
                       styleClass="status-item"/>

                <Separator orientation="VERTICAL"/>

                <Label fx:id="wordCountLabel"
                       text="Words: 0"
                       styleClass="status-item"/>

                <Label fx:id="charCountLabel"
                       text="Chars: 0"
                       styleClass="status-item"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="QuillPad v1.0"
                       styleClass="version-label"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
