<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.openjfx.controller.RegisterController"
            styleClass="login-container">

    <left>
        <VBox styleClass="login-left-panel"
              alignment="CENTER"
              prefWidth="400"
              minWidth="300">
            <children>
                <Label text="QuillPad" styleClass="app-title">
                    <font>
                        <Font name="System Bold" size="42"/>
                    </font>
                </Label>
                <Label text="Create your" styleClass="app-subtitle">
                    <font>
                        <Font size="24"/>
                    </font>
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
                <Label text="account" styleClass="app-subtitle">
                    <font>
                        <Font size="24"/>
                    </font>
                </Label>
            </children>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER"
              styleClass="login-right-panel"
              minWidth="400">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <VBox styleClass="form-container"
                      alignment="CENTER"
                      maxWidth="400"
                      spacing="15">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>

                    <HBox alignment="CENTER">
                        <children>
                            <Label text="Register" styleClass="app-title">
                                <font>
                                    <Font name="System Bold" size="28"/>
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="themeToggleButton"
                                    text="🌸"
                                    styleClass="theme-toggle-button"
                                    onAction="#handleThemeToggle"/>
                        </children>
                    </HBox>

                    <Label text="Enter your username and password"
                           styleClass="hint-label">
                        <font>
                            <Font size="12"/>
                        </font>
                    </Label>

                    <HBox styleClass="input-field-container" alignment="CENTER_LEFT">
                        <padding>
                            <Insets right="10" left="15"/>
                        </padding>
                        <TextField fx:id="usernameField"
                                   promptText="Choose a username"
                                   styleClass="form-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Label text="👤" styleClass="input-icon">
                            <HBox.margin>
                                <Insets left="5"/>
                            </HBox.margin>
                        </Label>
                    </HBox>

                    <HBox styleClass="input-field-container" alignment="CENTER_LEFT">
                        <padding>
                            <Insets right="10" left="15"/>
                        </padding>
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="passwordField"
                                           promptText="Create a password"
                                           styleClass="form-input"
                                           managed="true"
                                           visible="true"/>
                            <TextField fx:id="passwordTextField"
                                       promptText="Create a password"
                                       styleClass="form-input"
                                       managed="false"
                                       visible="false"/>
                        </StackPane>
                        <Label text="🔒" styleClass="input-icon">
                            <HBox.margin>
                                <Insets left="5"/>
                            </HBox.margin>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <children>
                            <CheckBox fx:id="showPasswordCheckBox"
                                      text="Show Password"
                                      styleClass="show-password-checkbox"
                                      onAction="#handleShowPasswordToggle"/>
                        </children>
                    </HBox>

                    <Label fx:id="errorLabel"
                           wrapText="true"
                           styleClass="error-label"/>

                    <Button maxWidth="Infinity"
                            prefHeight="45"
                            text="CREATE ACCOUNT"
                            styleClass="login-button"
                            onAction="#handleCreateAccount">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Button>

                    <Button maxWidth="Infinity"
                            prefHeight="45"
                            text="BACK TO LOGIN"
                            styleClass="register-button"
                            onAction="#handleBackToLogin">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Button>
                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>
